<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.tyvo.keyboard.settings.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:name="@string/ime_name"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeLocale="en_US" />
    <!-- Launched from another keyboard's mic key: a compact dictate-and-return
         UI, then back to the keyboard that launched us. -->
    <subtype
        android:name="@string/ime_name_voice"
        android:imeSubtypeMode="voice"
        android:imeSubtypeLocale="en_US" />
</input-method>
